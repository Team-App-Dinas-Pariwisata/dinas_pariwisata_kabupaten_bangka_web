{
  "name": "siparik-whatsapp-service",
  "version": "1.1.0",
  "private": true,
  "description": "Service WhatsApp Web SI PARIK untuk local, Docker, dan Railway",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "start:local": "node server.js",
    "docker:up": "docker compose -f docker-compose.local.yml up --build",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "check": "node --check server.js"
  },
  "dependencies": {
    "dotenv": "17.2.2",
    "express": "5.2.1",
    "qrcode": "1.5.4",
    "whatsapp-web.js": "1.34.7"
  }
}
