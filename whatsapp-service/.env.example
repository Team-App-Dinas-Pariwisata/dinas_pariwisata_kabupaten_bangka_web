# =============================================================
# KONFIGURASI UNIVERSAL - aman sebagai dasar untuk local/Railway
# Salin menjadi .env saat menjalankan langsung di komputer.
# =============================================================

PORT=3001
HOST=0.0.0.0

# Minimal 32 karakter. Nilai yang sama dipasang pada portal Next.js.
WA_SERVICE_API_KEY=ganti-dengan-kunci-acak-minimal-32-karakter

# LOCAL: simpan sesi di folder project agar restart tidak meminta QR lagi.
# RAILWAY: gunakan /data/.wwebjs_auth dan pasang Railway Volume di /data.
WA_SESSION_PATH=.wwebjs_auth
WA_CLIENT_ID=siparik
WA_DEFAULT_COUNTRY_CODE=62

# LOCAL: kosongkan agar Puppeteer memakai Chrome/Chromium bawaannya.
# RAILWAY DOCKER: sudah otomatis /usr/bin/chromium dari Dockerfile.
PUPPETEER_EXECUTABLE_PATH=

WA_RECONNECT_BASE_MS=5000
WA_RECONNECT_MAX_MS=60000
WA_MAX_MESSAGE_LENGTH=4096
WA_AUTO_START=true

# QR tampil di terminal saat local. Untuk Railway sebaiknya false.
WA_PRINT_QR_TERMINAL=true
