# ==========================================================
# Konfigurasi environment untuk Si Parik (proyek "pariwisata")
# Salin file ini menjadi ".env.local" lalu isi sesuai kredensial Anda.
# ==========================================================

# --- Database MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dinas_pariwisata
DB_CONNECTION_LIMIT=10

# --- Sesi login (WAJIB diisi acak & rahasia di production) ---
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# --- Login Google (untuk akun pemohon/pengaju) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kosongkan untuk auto-generate dari origin request, atau isi manual, contoh:
# GOOGLE_REDIRECT_URI=https://domain-anda.go.id/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- Penyimpanan gambar: Cloudflare R2 (utama) ---
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_OBJECT_PREFIX=appekraf
R2_JURISDICTION=default
R2_MAX_IMAGE_MB=10
R2_MAX_SUBMISSION_FILE_MB=5

# --- Penyimpanan gambar: ImgBB (alternatif/fallback) ---
IMGBB_API_KEY=

# --- Service NLP Python untuk chatbot rekomendasi AI ---
# Base URL service Python terpisah (tidak termasuk dalam repo ini).
NLP_API_URL=http://127.0.0.1:8000

# --- Pilihan provider notifikasi WhatsApp ---
# Pilihan: webjs = service Node.js milik sendiri, fonnte = API Fonnte.
# Untuk berpindah provider cukup ganti satu nilai ini, lalu restart/deploy ulang portal.
WHATSAPP_PROVIDER=webjs

# --- Provider 1: whatsapp-web.js / service Node.js ---
# Dipakai hanya jika WHATSAPP_PROVIDER=webjs.
# URL service Node.js terdapat pada folder /whatsapp-service.
# Jika portal dan service WA berada dalam project Railway yang sama:
# WA_SERVICE_URL=http://whatsapp-service.railway.internal:3000
# Jika portal berada di luar Railway, gunakan domain publik HTTPS service WA.
WA_SERVICE_URL=http://127.0.0.1:3001
# Harus sama persis dengan WA_SERVICE_API_KEY pada service WhatsApp (minimal 32 karakter).
WA_SERVICE_API_KEY=ganti-dengan-kunci-acak-minimal-32-karakter

# --- Provider 2: Fonnte ---
# Dipakai hanya jika WHATSAPP_PROVIDER=fonnte. Token wajib disimpan di server, bukan NEXT_PUBLIC_*.
FONNTE_TOKEN=
FONNTE_API_BASE_URL=https://api.fonnte.com
FONNTE_COUNTRY_CODE=62

# --- Kontrol kanal notifikasi ---
# true = lewati seluruh provider WhatsApp; email tetap dicoba.
DISABLE_WHATSAPP_NOTIFICATIONS=false
# Isi "email" jika WhatsApp sementara ingin dimatikan. Selain itu biarkan "whatsapp".
# Email tetap dikirim sesudah WhatsApp, baik WhatsApp berhasil maupun gagal.
NOTIF_CHANNEL=whatsapp

# URL publik aplikasi ini, dipakai untuk menyisipkan link ke pesan WhatsApp
# (opsional — jika kosong, pesan WA tetap terkirim tanpa link).
# Contoh: https://siparik.bangkabaratkab.go.id
APP_BASE_URL=
