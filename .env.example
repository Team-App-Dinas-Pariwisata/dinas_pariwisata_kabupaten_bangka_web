# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dinas_pariwisata
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Session aplikasi
SESSION_SECRET=ganti-dengan-random-secret-panjang-minimal-32-karakter

# Google OAuth — akun pengaju
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Cloudflare R2 — seluruh upload media dan dokumen pengajuan
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Opsional. Isi custom domain/public bucket URL untuk media publik.
# Dokumen pengajuan tetap disajikan melalui endpoint private aplikasi.
R2_PUBLIC_BASE_URL=
R2_OBJECT_PREFIX=appekraf
R2_JURISDICTION=default
R2_MAX_IMAGE_MB=10
R2_MAX_SUBMISSION_FILE_MB=5

# Alias credential lama tetap didukung oleh lib/r2.ts bila project Anda sudah memakainya:
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
