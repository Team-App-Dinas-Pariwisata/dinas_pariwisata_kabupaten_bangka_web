# ==========================================================
# Konfigurasi environment untuk Si Parik (proyek "pariwisata")
# Salin file ini menjadi ".env.local" lalu isi sesuai kredensial Anda.
# ==========================================================

# --- Firebase Realtime Database (runtime utama) ---
# Ambil URL dari Firebase Console > Realtime Database.
FIREBASE_DATABASE_URL=https://PROJECT_ID-default-rtdb.asia-southeast1.firebasedatabase.app
# Service account server-side. Jangan gunakan NEXT_PUBLIC_* untuk private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Opsional: legacy database secret/token sebagai alternatif service account.
FIREBASE_DATABASE_AUTH_TOKEN=

# --- MySQL lama (HANYA untuk sekali migrasi data ke Firebase) ---
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=dinas_pariwisata
# Ubah menjadi YES hanya ketika siap menjalankan: npm run migrate:firebase
MIGRATION_CONFIRM=NO

# --- Sesi login (WAJIB diisi acak & rahasia di production) ---
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# --- Login Google (untuk akun pemohon/pengaju) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kosongkan untuk auto-generate dari origin request, atau isi manual, contoh:
# GOOGLE_REDIRECT_URI=https://domain-anda.go.id/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- Penyimpanan gambar: Cloudflare R2 (utama) ---
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_OBJECT_PREFIX=appekraf
R2_JURISDICTION=default
R2_MAX_IMAGE_MB=10
R2_MAX_SUBMISSION_FILE_MB=5

# --- Penyimpanan gambar: ImgBB (alternatif/fallback) ---
IMGBB_API_KEY=

# --- Service NLP Python untuk chatbot rekomendasi AI ---
# Base URL service Python terpisah (tidak termasuk dalam repo ini).
NLP_API_URL=http://127.0.0.1:8000

# --- Notifikasi WhatsApp: FlazHost WhatsApp Gateway ---
# Dokumentasi: https://flazhost.com/api/wa/v1
# API key wajib memiliki scope `send`; status device memakai endpoint devices.read.
# Simpan semua credential hanya di server, jangan gunakan NEXT_PUBLIC_*.
FLAZHOST_WA_BASE_URL=https://flazhost.com/api/wa/v1
FLAZHOST_WA_KEY=
FLAZHOST_WA_DEVICE_ID=

# --- Kontrol kanal notifikasi ---
# true = lewati seluruh provider WhatsApp; email tetap dicoba.
DISABLE_WHATSAPP_NOTIFICATIONS=false
# Isi "email" jika WhatsApp sementara ingin dimatikan. Selain itu biarkan "whatsapp".
# Email tetap dikirim sesudah WhatsApp, baik WhatsApp berhasil maupun gagal.
NOTIF_CHANNEL=whatsapp

# URL publik aplikasi ini, dipakai untuk menyisipkan link ke pesan WhatsApp
# (opsional — jika kosong, pesan WA tetap terkirim tanpa link).
# Contoh: https://siparik.bangkabaratkab.go.id
APP_BASE_URL=
