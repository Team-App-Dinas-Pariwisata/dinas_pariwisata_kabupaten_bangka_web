@media (max-width: 760px) {
  .spk-search-section { padding-top: 34px; }
  .spk-search-form,
  .spk-result-panel { border-radius: 20px; }
  .spk-form-heading,
  .spk-form-section { padding-left: 20px; padding-right: 20px; }
  .spk-submit-button { width: calc(100% - 40px); margin-left: 20px; margin-right: 20px; }
  .spk-error-box { margin-left: 20px; margin-right: 20px; }
  .spk-field-grid.two,
