R2_JURISDICTION=default
R2_MAX_IMAGE_MB=10
R2_MAX_SUBMISSION_FILE_MB=5

# --- Penyimpanan gambar: ImgBB (alternatif/fallback) ---
IMGBB_API_KEY=

# --- Service NLP Python untuk chatbot rekomendasi AI ---
# Base URL service Python terpisah (tidak termasuk dalam repo ini).
NLP_API_URL=http://127.0.0.1:8000

# --- Notifikasi WhatsApp via Fonnte (BARU) ---
# Token device, didapat dari dashboard Fonnte: https://fonnte.com
# Dipakai untuk mengirim WA otomatis ke pemohon saat petugas
# menyetujui/menolak pengajuan (ekraf, SDM pariwisata, komunitas).
# Jika dikosongkan, notifikasi WA hanya akan dicatat sebagai warning di log
# dan TIDAK menggagalkan proses verifikasi.
FONNTE_TOKEN=

