  transition: color .25s ease;
}

.desktop-nav a:hover,
.desktop-nav a.active { color: white; }

.desktop-nav a.active::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 4px;
  height: 2px;
  border-radius: 99px;
