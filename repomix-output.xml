.portal-brand-mark { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: rgba(255,255,255,.94); color: #315f75; font-size: 16px; font-weight: 900; }
.portal-brand > span:last-child { display: flex; flex-direction: column; }
.portal-brand strong { font-size: 14px; letter-spacing: .08em; }
.portal-brand small { margin-top: 3px; color: rgba(255,255,255,.72); font-size: 12px; }
.portal-menu-title { padding: 24px 10px 10px; font-family: var(--app-font); font-size: 16px; font-weight: 800; letter-spacing: .03em; }
